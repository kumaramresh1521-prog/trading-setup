# Active Broker Selection: ANGEL (default) | UPSTOX | KOTAK | FYERS
DATA_BROKER=ANGEL

# ==============================================================================
# 1. 🪽 Angel One SmartAPI (Default)
# ==============================================================================
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
ANGEL_TOTP_CODE=
ANGEL_BASE_URL=https://apiconnect.angelone.in

# ==============================================================================
# 2. 📈 Upstox API v2
# ==============================================================================
# Generate Access Token from: https://service.upstox.com/developer/
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# ==============================================================================
# 3. ⚡ Kotak Securities Neo API
# ==============================================================================
# Get credentials from: https://neo.kotaksecurities.com/
KOTAK_ACCESS_TOKEN=
KOTAK_CONSUMER_KEY=
KOTAK_CONSUMER_SECRET=
KOTAK_VIEW_TOKEN=
KOTAK_MOBILE_NO=
KOTAK_MPIN=

# ==============================================================================
# 4. 🎯 Fyers API v3
# ==============================================================================
# Get App ID & Access Token from: https://myapi.fyers.in/
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=

# ==============================================================================
# ⚙️ Server & Network Settings
# ==============================================================================
PORT=8000
HOST=127.0.0.1

SMARTAPI_CLIENT_LOCAL_IP=
SMARTAPI_CLIENT_PUBLIC_IP=
SMARTAPI_MAC_ADDRESS=

BREADTH_MAX_WORKERS=1
BREADTH_REQUEST_DELAY_MS=1200
BREADTH_LIVE_CACHE_TTL_SEC=60

